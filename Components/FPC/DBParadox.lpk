<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="4">
    <PathDelim Value="\"/>
    <Name Value="DBParadox"/>
    <Type Value="RunAndDesignTime"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\Source;$(FPCSrcDir)\packages\pxlib\src"/>
        <UnitOutputDirectory Value="..\..\bin\lib\$(PkgName)\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Files Count="3">
      <Item1>
        <Filename Value="..\Source\DBParadoxConnection.pas"/>
        <UnitName Value="DBParadoxConnection"/>
      </Item1>
      <Item2>
        <Filename Value="..\Source\DBParadoxSQLParser.pas"/>
        <UnitName Value="DBParadoxSQLParser"/>
      </Item2>
      <Item3>
        <Filename Value="..\Source\DBParadoxWriteBuffer.pas"/>
        <UnitName Value="DBParadoxWriteBuffer"/>
      </Item3>
    </Files>
    <RequiredPkgs Count="1">
      <Item1>
        <PackageName Value="FCL"/>
      </Item1>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
