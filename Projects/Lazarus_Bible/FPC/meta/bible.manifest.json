      "units": ["view/Frm_HelloMAIN.pas", "viewmodel/HelloViewModel.pas"],
      "markers": [
        {"file": "viewmodel/HelloViewModel.pas", "text": "THelloViewModel = class", "title": "Das ViewModel"},
        {"file": "view/Frm_HelloMAIN.pas", "text": "procedure TForm1.ApplyViewModel", "title": "Die View bindet sich an das ViewModel"}
      ],
      "notes": "Erste Demo im MVVM-Muster: die Logik liegt im ViewModel, die View zeigt nur an.",
