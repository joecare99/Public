    {
      "key": "HELLO",
      "title": "Hallo Delphi Programmer",
      "summary": "Das kleinste moegliche Fenster: ein Knopf und ein Text.",
      "learning": "Aufbau eines Fensters, Ereignisbehandlung, View und ViewModel.",
      "folder": "HELLO",
      "project": "Hello",
      "units": ["view/Frm_HelloMAIN.pas", "viewmodel/HelloViewModel.pas"],
      "markers": [
        {"file": "viewmodel/HelloViewModel.pas", "text": "THelloViewModel = class", "title": "Das ViewModel"},
        {"file": "view/Frm_HelloMAIN.pas", "text": "procedure TForm1.ApplyViewModel", "title": "Die View bindet sich an das ViewModel"}
      ],
      "notes": "Erste Demo im MVVM-Muster: die Logik liegt im ViewModel, die View zeigt nur an.",
      "showcase": true
    },
    {
      "key": "Calc32",
      "title": "Taschenrechner (32 Bit)",
      "summary": "Rechner mit dezimaerer, hexadezimaerer und binaerer Anzeige.",
      "learning": "Model (Rechenlogik), ViewModel (Anzeigewerte), View (Bedienelemente).",
      "folder": "Calc32",
      "project": "Calc32",
      "units": ["view/Frm_CALC.pas", "viewmodel/Calc32ViewModel.pas", "model/CalculatorModel.pas"],
      "markers": [
        {"file": "model/CalculatorModel.pas", "text": "TCalculatorModel = class", "title": "Das Rechenmodell"},
        {"file": "viewmodel/Calc32ViewModel.pas", "text": "TCalc32ViewModel = class", "title": "Das ViewModel"},
        {"file": "view/Frm_CALC.pas", "text": "procedure TfrmCalcMain.ApplyViewModel", "title": "Die View zeigt die Werte an"}
      ],
      "notes": "Die Rechenlogik ist vollstaendig ins Model gewandert; das ViewModel meldet Aenderungen.",
      "showcase": true
    },
    {
      "key": "README",
      "title": "Readme anzeigen",
      "summary": "Zeigt eine Textdatei an und oeffnet sie im Standardprogramm.",
      "learning": "Model (Dokument), ViewModel, Dienste (Datei, Prozess).",
      "folder": "README",
      "project": "Readme",
      "units": ["view/Frm_ReadMeMain.pas", "viewmodel/ReadMeViewModel.pas", "model/ReadMeDocument.pas"],
      "markers": [
        {"file": "viewmodel/ReadMeViewModel.pas", "text": "TReadMeViewModel = class", "title": "Das ViewModel mit den Diensten"},
