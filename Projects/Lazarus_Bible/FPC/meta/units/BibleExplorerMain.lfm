object BibleExplorerForm: TBibleExplorerForm
  Left = 0
  Top = 0
  Caption = 'Delphi-Bible Explorer'
  ClientHeight = 620
  ClientWidth = 980
  Color = clBtnFace
  Font.Color = clWindowText
  Font.Height = -11
  Font.Name = 'MS Sans Serif'
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  Position = poScreenCenter
  object Splitter1: TSplitter
    Left = 250
    Top = 0
    Width = 6
    Height = 620
  end
  object TreeView: TTreeView
    Left = 0
    Top = 0
    Width = 250
    Height = 620
    Anchors = [akLeft, akTop, akBottom]
    Color = clWindow
    TabOrder = 1
    OnChange = TreeViewNodeClick
  end
  object TabControl: TTabControl
    Left = 256
    Top = 0
    Width = 724
    Height = 620
    Anchors = [akLeft, akTop, akRight, akBottom]
    TabIndex = 0
    TabOrder = 2
    OnChange = TabControlChange
    object tabOverview: TTabSheet
      Caption = 'Ueberblick'
      ClientHeight = 590
      ClientWidth = 716
      object lblTitle: TLabel
        Left = 16
        Top = 16
        Width = 660
        Height = 24
        Caption = 'Demo'
        Font.Color = clNavy
        Font.Height = -15
        Font.Style = [fsBold]
      end
      object lblSummary: TLabel
        Left = 16
        Top = 48
        Width = 660
        Height = 40
        Caption = 'Kurzbeschreibung'
        WordWrap = True
      end
      object lblLearning: TLabel
        Left = 16
        Top = 96
        Width = 660
        Height = 60
        Caption = 'Lernziel'
        WordWrap = True
      end
      object memoOverview: TMemo
        Left = 16
        Top = 168
        Width = 660
        Height = 380
        Anchors = [akLeft, akTop, akRight, akBottom]
        ReadOnly = True
        ScrollBars = ssVertical
        TabOrder = 0
        WordWrap = True
      end
    end
    object tabCode: TTabSheet
      Caption = 'Code'
      ClientHeight = 590
      ClientWidth = 716
      object btnPrevious: TButton
        Left = 8
        Top = 8
        Width = 80
        Height = 25
        Caption = '< vorher'
        TabOrder = 0
        OnClick = btnPreviousClick
      end
      object btnNext: TButton
        Left = 96
        Top = 8
        Width = 80
        Height = 25
        Caption = 'naechste >'
        TabOrder = 1
        OnClick = btnNextClick
      end
      object codeView: TBibleCodeView
        Visible = False
        Left = 8
        Top = 40
        Width = 700
        Height = 534
        Anchors = [akLeft, akTop, akRight, akBottom]
        TabOrder = 2
      end
    end
    object tabBehavior: TTabSheet
      Caption = 'Verhalten'
      ClientHeight = 590
      ClientWidth = 716
      object btnStart: TButton
        Left = 8
        Top = 8
        Width = 100
        Height = 25
        Caption = 'Starten'
        TabOrder = 0
        OnClick = btnStartClick
      end
      object btnShot: TButton
        Left = 116
        Top = 8
        Width = 100
        Height = 25
        Caption = 'Screenshot'
        TabOrder = 1
        OnClick = btnShotClick
      end
      object imgBehavior: TImage
        Left = 8
        Top = 40
        Width = 320
        Height = 240
        Proportional = True
      end
      object memoBehavior: TMemo
        Left = 336
        Top = 40
        Width = 372
        Height = 240
        Anchors = [akLeft, akTop, akRight]
        ReadOnly = True
        ScrollBars = ssVertical
        TabOrder = 3
        WordWrap = True
      end
      object pnlBehavior: TPanel
        Left = 8
        Top = 288
        Width = 700
        Height = 286
        Anchors = [akLeft, akTop, akRight, akBottom]
        BevelOuter = bvLowered
      end
    end
    object tabFiles: TTabSheet
      Caption = 'Dateien'
      ClientHeight = 590
      ClientWidth = 716
      object listFiles: TListBox
        Left = 8
        Top = 8
        Width = 300
        Height = 566
        Anchors = [akLeft, akTop, akBottom]
        ItemHeight = 20
        TabOrder = 0
        OnDblClick = listFilesDblClick
      end
    end
    object tabNotes: TTabSheet
      Caption = 'Notizen'
      ClientHeight = 590
      ClientWidth = 716
      object memoNotes: TMemo
        Left = 8
        Top = 8
        Width = 700
        Height = 566
        Anchors = [akLeft, akTop, akRight, akBottom]
        ReadOnly = True
        ScrollBars = ssVertical
        TabOrder = 0
        WordWrap = True
      end
    end
  end
  object MainMenu1: TMainMenu
    Left = 8
    Top = 0
    object mnuFile: TMenuItem
      Caption = 'Datei'
      object mnuReload: TMenuItem
        Caption = 'Index neu laden'
        OnClick = mnuReloadClick
      end
      object mnuOpen: TMenuItem
        Caption = 'Projektordner oeffnen'
      end
      object mnuQuit: TMenuItem
        Caption = 'Beenden'
        OnClick = mnuQuitClick
      end
    end
    object mnuDemo: TMenuItem
      Caption = 'Demo'
      object mnuStart: TMenuItem
        Caption = 'Demo starten'
        OnClick = mnuStartClick
      end
      object mnuShot: TMenuItem
        Caption = 'Screenshot erzeugen'
        OnClick = mnuShotClick
      end
    end
    object mnuAbout: TMenuItem
      Caption = 'Ueber'
    end
  end
  object lblStatus: TLabel
    Left = 256
    Top = 600
    Width = 700
    Height = 17
    Anchors = [akLeft, akRight, akBottom]
    Caption = 'bereit'
  end
end
