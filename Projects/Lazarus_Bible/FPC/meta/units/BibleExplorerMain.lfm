object BibleExplorerForm: TBibleExplorerForm
  Left = 0
  Top = 0
  Caption = 'Delphi-Bible Explorer'
  ClientHeight = 620
  ClientWidth = 980
  Color = clBtnFace
  Font.Color = clWindowText
  Font.Height = -11
  Font.Name = 'MS Sans Serif'
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  OnShow = FormShow
  Position = poScreenCenter
  object Splitter1: TSplitter
    Left = 250
    Top = 0
    Width = 6
    Height = 620
  end
  object TreeView: TTreeView
    Left = 0
    Top = 0
    Width = 250
    Height = 620
    Anchors = [akLeft, akTop, akBottom]
    Color = clWindow
    TabOrder = 1
    OnChange = TreeViewNodeClick
  end
  object PageControl: TPageControl
    Left = 256
    Top = 0
    Width = 724
    Height = 572
    Anchors = [akLeft, akTop, akRight, akBottom]
    TabIndex = 0
