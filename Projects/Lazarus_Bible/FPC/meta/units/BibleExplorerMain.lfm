      end
      object memoOverview: TMemo
        Left = 16
        Top = 168
        Width = 660
        Height = 380
        Anchors = [akLeft, akTop, akRight, akBottom]
        ReadOnly = True
        ScrollBars = ssVertical
        TabOrder = 0
        WordWrap = True
      end
    end
