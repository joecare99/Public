procedure TGregorianCalendarForm.btnFollowYearClick(Sender : TObject);
var
  currentYear: Longint;
begin

  currentYear := StrToInt(edtYear.Text);
  if currentYear < 2499 then
  begin
    edtYear.Text := IntToStr(currentYear + 1);
    Kal(Sender);
  end
  else
  begin
    MessageDlg('Nein, nein ...', 'Das Jahr muss kleiner als 2500 sein.',
      mtWarning, [mbOK], 0);
    edtYear.Text := IntToStr(RequireViewModel.Year);
  end;
end;

procedure TGregorianCalendarForm.btnPrevYearClick(Sender : TObject);
var
  currentYear: Longint;
begin

  currentYear := StrToInt(edtYear.Text);
  if currentYear > 1581 then
  begin
    edtYear.Text := IntToStr(currentYear - 1);
    Kal(Sender);
  end
  else
  begin
    MessageDlg('Nein, nein ...', 'Das Jahr muss größer als 1581 sein.',
      mtWarning, [mbOK], 0);
    edtYear.Text := IntToStr(RequireViewModel.Year);
  end;
end;

procedure TGregorianCalendarForm.edtYearChange(Sender : TObject);
var
  lYear: Longint;
begin
  if Length(edtYear.Text) <> 4 then
    Exit;

  if not TryStrToInt(edtYear.Text, lYear) then
    Exit;

  if (lYear > 1581) and (lYear < 2500) then
  begin
    Kal(Sender);
  end
  else
  begin
    if lYear <= 1581 then
    MessageDlg('Nein, nein ...', 'Das Jahr muss größer als 1581 sein.',
      mtWarning, [mbOK], 0);

    if lYear >= 2500 then
      MessageDlg('Nein, nein ...', 'Das Jahr muss kleiner als 2500 sein.',
        mtWarning, [mbOK], 0);

    edtYear.Text := IntToStr(RequireViewModel.Year);
  end;
end;

