procedure TGregorianCalendarForm.gridleeren(Sender : TObject);
var
  row, column: Integer;
begin
  for row := 0 to StringGrid1.RowCount - 1 do
    for column := 0 to StringGrid1.ColCount - 1 do
    begin
      StringGrid1.Cells[column, row] := '';
      StringGrid2.Cells[column, row] := '';
      StringGrid3.Cells[column, row] := '';
    end;
end;

procedure TGregorianCalendarForm.Kal(Sender : TObject);
var
  grids: array[0..2] of TStringGrid;
  gridIndex, column, row: Integer;
  dayText: string;
  calendarViewModel: IGregorianCalendarViewModel;
begin
  calendarViewModel := RequireViewModel;
  if edtYear.Text = '' then
    edtYear.Text := IntToStr(calendarViewModel.Year);

  calendarViewModel.Year := StrToInt(edtYear.Text);
  gridleeren(Sender);

  grids[0] := StringGrid1;
  grids[1] := StringGrid2;
  grids[2] := StringGrid3;
  for gridIndex := Low(grids) to High(grids) do
  begin
    for row := 0 to grids[gridIndex].RowCount - 1 do
      grids[gridIndex].Cells[0, row] := calendarViewModel.GetWeekdayLabel(row);

    for column := 0 to grids[gridIndex].ColCount - 1 do
      for row := 0 to grids[gridIndex].RowCount - 1 do
      begin
        dayText := calendarViewModel.GetDayCellText(gridIndex, column, row);
        if dayText <> '' then
          grids[gridIndex].Cells[column, row] :=
            dayText;
      end;
  end;
end;
