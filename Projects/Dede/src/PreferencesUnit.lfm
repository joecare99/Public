object PrefsForm: TPrefsForm
  Left = 524
  Height = 313
  Top = 162
  Width = 463
  BorderStyle = bsDialog
  Caption = 'Preferences'
  ClientHeight = 313
  ClientWidth = 463
  Color = clBtnFace
  Font.Color = clWindowText
  Font.Height = -11
  Font.Name = 'MS Sans Serif'
  Position = poScreenCenter
  LCLVersion = '4.8.0.0'
  OnClose = FormClose
  OnCreate = FormCreate
  OnShow = FormShow
  object pc: TPageControl
    Left = 8
    Height = 265
    Top = 8
    Width = 449
    ActivePage = TabSheet1
    TabIndex = 1
    TabOrder = 0
    object TabSheet2: TTabSheet
      Caption = 'General'
      ClientHeight = 0
      ClientWidth = 0
      ImageIndex = 1
      object Bevel1: TBevel
        Left = 8
        Height = 9
        Top = 68
        Width = 425
        Shape = bsTopLine
        Style = bsRaised
      end
      object O1: TCheckBox
        Left = 8
        Height = 17
        Top = 16
        Width = 313
        Caption = 'Do not allow report to be saved in existing folder'
        Checked = True
        State = cbChecked
        TabOrder = 0
      end
      object O2: TCheckBox
        Left = 8
        Height = 17
        Top = 40
        Width = 313
        Caption = 'Warn before overwriting files'
        Checked = True
        State = cbChecked
        TabOrder = 1
      end
      object RShE: TCheckBox
        Left = 8
        Height = 17
        Top = 80
        Width = 281
        Caption = 'Add "Open with DeDe" to the explorer context menu'
        TabOrder = 2
      end
    end
    object TabSheet1: TTabSheet
      Caption = 'References'
      ClientHeight = 0
      ClientWidth = 0
      object SRTypeRG: TRadioGroup
        Left = 8
        Height = 66
        Hint = '  From here you can adjust the charset used by DeDe for seeking '#13#10'string references. If you expect that your targets have english'#13#10'strings only then for best results use (#32..#128) interval. If there'#13#10'are other languages strings in them use some of the other sets.'#13#10'  Note: Using the full set (#32..#255) will certainly lead to some'#13#10'not correctly "found" string references.'
        Top = 5
        Width = 181
        AutoFill = True
        Caption = 'String References'
        ChildSizing.LeftRightSpacing = 6
        ChildSizing.EnlargeHorizontal = crsHomogenousChildResize
        ChildSizing.EnlargeVertical = crsHomogenousChildResize
        ChildSizing.ShrinkHorizontal = crsScaleChilds
        ChildSizing.ShrinkVertical = crsScaleChilds
        ChildSizing.Layout = cclLeftToRightThenTopToBottom
        ChildSizing.ControlsPerLine = 1
        ClientHeight = 66
        ClientWidth = 181
        ItemIndex = 0
        Items.Strings = (
          'Search from #32 to #255'
          'Search from #32 to #192'
          'Search from #32 to #128'
        )
        ParentBackground = False
        ParentShowHint = False
        ShowHint = True
        TabOrder = 0
      end
      object GroupBox1: TGroupBox
        Left = 200
        Height = 66
        Hint = '  Class emulator options are related to how DeDe to use the DOI'#13#10'technology'
        Top = 5
        Width = 233
        Caption = 'Class Emulation Options'
        ClientHeight = 66
        ClientWidth = 233
        ParentBackground = False
        ParentShowHint = False
        ShowHint = True
        TabOrder = 1
        object DOICB: TCheckBox
          Left = 8
          Height = 16
          Hint = '  If this is not checked you wont see any DOI references.'#13#10'  Hardly recommended to be checked ! Anyway if you dont need the'#13#10'DOI references information you can turn this option off. Note that even '#13#10'then emulator will continue to work, so this will not speed up the '#13#10'disassembly time.'
          Top = 16
          Width = 129
          Caption = 'Show DOI references'
          TabOrder = 0
          OnClick = DOICBClick
        end
        object DOIUNKCB: TCheckBox
          Left = 8
          Height = 13
          Hint = '   If you dont want to see this <UncknownType> references you can '#13#10'turn this off. I do not recommend having this option checked  for'#13#10'not experienced in delphi peoples as well as not experienced DeDe'#13#10'users.'
          Top = 32
          Width = 217
          Caption = 'Dont show <UnknownType> references'
          TabOrder = 1
        end
        object SmartCB: TCheckBox
          Left = 8
          Height = 14
          Hint = '  When this option is checked and there are more than one'#13#10'possible DSF references to a single call DeDe tries to select the'#13#10'right one using additinal information from registers status. I do'#13#10'recommend having this option checked.'
          Top = 47
          Width = 105
          Caption = 'Smart DSF Mode'
          TabOrder = 2
        end
      end
      object GroupBox2: TGroupBox
        Left = 8
        Height = 99
        Hint = '  Options related to the class dump engine'
        Top = 131
        Width = 425
        Caption = 'Class Dumper Options'
        ClientHeight = 99
        ClientWidth = 425
        ParentBackground = False
        ParentShowHint = False
        ShowHint = True
        TabOrder = 2
        object Label3: TLabel
          Left = 48
          Height = 13
          Top = 52
          Width = 130
          Caption = 'Run target with parameters:'
        end
        object DumpAllCB: TCheckBox
          Left = 8
          Height = 17
          Hint = '   If this is not checked you wont see those ~PROC~xxyyzztt'#13#10'procedures.'
          Top = 18
          Width = 249
          Caption = 'Dump additional non event handler procedures'
          TabOrder = 0
        end
        object ObjPropCB: TCheckBox
          Left = 8
          Height = 17
          Hint = '   When this is checked DeDe will try to load the target'#13#10'and will read some valueable information from the new'#13#10'process memory that will be used later on.'#13#10'   I do recommend this option to be ALWAYS checked!'#13#10'   If it is not DeDe will work little faster, but you will not'#13#10'have global var references, no unit inforamation, DOI'#13#10'engine will work no more than 40% of its potential and'#13#10'many more *bad* things.'
          Top = 34
          Width = 281
          Caption = 'Dump extra data and search for obj/prop references'
          TabOrder = 1
        end
        object RunParamsEdit: TEdit
          Left = 48
          Height = 21
          Top = 68
          Width = 201
          TabOrder = 2
        end
      end
      object GroupBox3: TGroupBox
        Left = 8
        Height = 49
        Top = 72
        Width = 425
        Caption = 'Call References'
        ClientHeight = 49
        ClientWidth = 425
        ParentBackground = False
        TabOrder = 3
        object ImportsCB: TCheckBox
          Left = 8
          Height = 17
          Hint = '    When this option is checked DeDe tried to resolve '#13#10'imported function references. Uncheck this to avoid'#13#10'problems with dumped executables with not properly'#13#10'restored import section / import direcroty entry.'
          Top = 16
          Width = 161
          Caption = 'Resolve Import References'
          ParentShowHint = False
          ShowHint = True
          TabOrder = 0
        end
        object UnitsCB: TCheckBox
          Left = 200
          Height = 17
          Hint = '    When this option is checked DeDe will give'#13#10'name to any unresolved method using pattern'#13#10'UnitName.Proc_PROC_ADDRESS'
          Top = 16
          Width = 145
          Caption = 'Name unresolved calls'
          ParentShowHint = False
          ShowHint = True
          TabOrder = 1
        end
      end
    end
    object TabSheet3: TTabSheet
      Caption = 'Symbols'
      ClientHeight = 0
      ClientWidth = 0
      ImageIndex = 2
      object Label1: TLabel
        Left = 8
        Height = 13
        Top = 8
        Width = 156
        Caption = 'At startup load these symbol files:'
      end
      object LoadSLB: TListBox
        Left = 8
        Height = 170
        Top = 23
        Width = 425
        Color = clWhite
        ItemHeight = 13
        MultiSelect = True
        TabOrder = 0
      end
      object Button3: TButton
        Left = 295
        Height = 21
        Top = 202
        Width = 66
        Caption = '&Add'
        TabOrder = 1
        OnClick = AddSBtnClick
      end
      object RmvBtn: TButton
        Left = 367
        Height = 21
        Top = 202
        Width = 66
        Caption = '&Remove'
        TabOrder = 2
        OnClick = RemoveSBtnClick
      end
      object AllDSFCb: TCheckBox
        Left = 8
        Height = 17
        Top = 203
        Width = 169
        Caption = 'Show all found DSF references'
        Checked = True
        Enabled = False
        State = cbChecked
        TabOrder = 3
      end
    end
    object TabSheet4: TTabSheet
      Caption = 'PlugIns'
      ClientHeight = 0
      ClientWidth = 0
      ImageIndex = 3
      object Label2: TLabel
        Left = 8
        Height = 13
        Top = 8
        Width = 75
        Caption = 'Loaded plugins:'
      end
      object PlugInLB: TListBox
        Left = 8
        Height = 170
        Top = 23
        Width = 425
        Color = clWhite
        ItemHeight = 13
        MultiSelect = True
        TabOrder = 0
      end
      object Button4: TButton
        Left = 344
        Height = 21
        Top = 200
        Width = 89
        Caption = '&Load PlugIns'
        TabOrder = 1
        OnClick = Button4Click
      end
    end
  end
  object CancelBtn: TButton
    Left = 381
    Height = 25
    Top = 281
    Width = 75
    Caption = '&Cancel'
    TabOrder = 1
    OnClick = CancelBtnClick
  end
  object OKBtn: TButton
    Left = 301
    Height = 25
    Top = 281
    Width = 75
    Caption = '&OK'
    TabOrder = 2
    OnClick = OKBtnClick
  end
  object OpenSymDlg: TOpenDialog
    DefaultExt = '.dsf'
    Filter = 'DeDe Symbol Files (*.dsf)|*.dsf'
    Options = [ofHideReadOnly, ofAllowMultiSelect, ofEnableSizing]
    Left = 126
    Top = 277
  end
  object PlugDlg: TOpenDialog
    Title = 'Load DeDe PlugIn'
    DefaultExt = '.dll'
    Filter = 'Files Exporting Plugins (*.dll)|*.dll'
    Left = 158
    Top = 277
  end
end
