procedure TForm1.Proc_005D97B8(const TextCol0, TextCol1: string; var RowIndex: Integer);
begin
  // 1. Zeilenzähler erhöhen
  Inc(RowIndex);

  // 2. Neue Zeile im StringGrid hinzufügen
  StringGrid5.RowCount := StringGrid5.RowCount + 1; // Feld bei Offset $0674

  // 3. Werte in Spalte 0 und Spalte 1 der neuen Zeile eintragen
  StringGrid5.Cells[0, RowIndex] := TextCol0;
  StringGrid5.Cells[1, RowIndex] := TextCol1;
end;


function TForm1.Proc_005D3B50(Day1, Month1, Year1: string;
  Day2Def, Month2Def, Year2Def: string;
  Day2, Month2, Year2: string): string;
var
  OnlyYears: Integer;
  ValidDates: Boolean;
  D1, M1, Y1: Integer;
  D2, M2, Y2: Integer;
  DiffDay, DiffMonth, DiffYear: Integer;
  DaysInM: Integer;
  StrDay, StrMonth, StrYear: string;
begin
  Result := '';
  OnlyYears := 0;

  // 1. Wenn kein Startjahr angegeben ist, Standardwerte übernehmen
  if Trim(Year1) = '' then
  begin
    Day1 := Day2Def;
    Month1 := Month2Def;
    Year1 := Year2Def;
    OnlyYears := 1;
  end;

  StrDay := '';
  StrMonth := '';
  StrYear := '';
  ValidDates := True;

  // 2. Datum 1 auf Gültigkeit prüfen
  try
    StrToDate(Day1 + '.' + Month1 + '.' + Year1);
  except
    ValidDates := False;
  end;

  // 3. Datum 2 auf Gültigkeit prüfen
  if ValidDates then
  begin
    try
      StrToDate(Day2 + '.' + Month2 + '.' + Year2);
    except
      ValidDates := False;
    end;
  end;

  // 4. Differenzberechnung bei gültigen Datumsangaben
  if ValidDates then
  begin
    D1 := StrToInt(Day1);
    M1 := StrToInt(Month1);
    Y1 := StrToInt(Year1);

    D2 := StrToInt(Day2);
    M2 := StrToInt(Month2);
    Y2 := StrToInt(Year2);

    DiffDay   := D2 - D1;
    DiffMonth := M2 - M1;
    DiffYear  := Y2 - Y1;

    // Übertrag Tage
    if DiffDay < 0 then
    begin
      Dec(DiffMonth);
      try
        // Ermittelt Tage des Monats von Datum 1
        DaysInM := DaysInAMonth(Y1, M1); // Proc_00492AC0
        DiffDay := (DaysInM - D1) + D2;
      except
      end;
    end;

    // Übertrag Monate
    if DiffMonth < 0 then
    begin
      Dec(DiffYear);
      Inc(DiffMonth, 12);
    end;

    // Teilstrings zusammenbauen
    if DiffDay > 0 then
      StrDay := IntToStr(DiffDay) + ' T';

    if DiffMonth > 0 then
      StrMonth := IntToStr(DiffMonth) + ' M ';

    if DiffYear > 0 then
      StrYear := IntToStr(DiffYear) + ' J ';

    // Ausgabe
    if OnlyYears = 1 then
      Result := StrYear
    else
      Result := StrYear + StrMonth + StrDay;
  end
  else
  begin
    // 5. Fallback: Nur Jahresdifferenz berechnen
    if (Trim(Year1) <> '') and (Trim(Year2) <> '') then
    begin
      try
        DiffYear := StrToInt(Year2) - StrToInt(Year1);

        // Wenn noch unvollständige Teilangaben (Tage/Monate) vorhanden sind -> 'ca. X J'
        if (Trim(Day1) <> '') or (Trim(Month1) <> '') or
           (Trim(Day2) <> '') or (Trim(Month2) <> '') then
        begin
          Result := 'ca. ' + IntToStr(DiffYear) + ' J';
        end
        else
        begin
          Result := IntToStr(DiffYear) + ' J';
        end;
      except
      end;
    end;
  end;
end;

