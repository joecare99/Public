procedure TForm1.speich1(Sender : TObject);
begin
  if DeleteEmptyPersonRecordIfNeeded(DataModule2.Table1,
    DataModule2.Table1Name.AsString, DataModule2.Table1Vornamen.AsString) then
    Exit;

  if DataModule2.Table1.State <> dsInsert then
    Exit;

  if PostPersonIfNumberAvailable(DataModule2.Table1, DataModule2.Table3,
    DataModule2.Table1Nummer.AsInteger) = pioDuplicateNumber then
  begin
    // The listing formats the low word of the Table1 component reference here.
    ShowMessage(rsSaveDSNotPossib +
      IntToStr(Word(PtrUInt(Pointer(DataModule2.Table1)) and $FFFF)) +
      rsCloseBr);
  end
end;
