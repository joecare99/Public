procedure TForm1.DBGrid3Exit(Sender : TObject);
begin
  DBGrid3.Visible := False;
  Label81.Visible := False;
  ActiveControl := DBComboBox3;
end;

procedure TForm1.DBGrid3KeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = $001B then
  begin
    DBComboBox3.Text := '';
    DBGrid3.Visible := False;
    Label81.Visible := False;
    ActiveControl := DBComboBox3;
  end;
end;

