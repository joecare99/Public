procedure TMainFormCloseActions.DeleteGeneratedReportFiles;
var
  Index: Integer;
  FileName: string;
begin
  FForm.PersonEditFrame.FileListBox2.Directory := GetCurrentDir;
  FForm.PersonEditFrame.FileListBox2.Mask := rsQ_SpS;
  for Index := 0 to FForm.PersonEditFrame.FileListBox2.Items.Count - 1 do
  begin
    FileName := IncludeTrailingPathDelimiter(
      FForm.PersonEditFrame.FileListBox2.Directory) +
      FForm.PersonEditFrame.FileListBox2.Items[Index];
    DeleteFileOrRaise(FileName);
  end;
end;

