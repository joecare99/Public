    raise EArgumentNilException.Create('CloseAction');
  FForm := AForm;
  FCloseAction := CloseAction;
end;

procedure TMainFormCloseActions.DeleteFileOrRaise(const FileName: string);
begin
  if FileExists(FileName) and not SysUtils.DeleteFile(FileName) then
    raise EInOutError.CreateFmt('Could not delete file "%s".', [FileName]);
end;

procedure TMainFormCloseActions.PostDataSetOrReportError(DataSet: TDataSet;
  const DataSetName: string);
begin
  // Delphi treats Post in browse mode as a no-op; FPC raises in that state.
  if not (DataSet.State in dsEditModes) then
    Exit;

  try
    DataSet.Post;
  except
    on E: EDatabaseError do
      ShowMessage(Format(rsClosePostError, [DataSetName, E.Message]));
  end;
end;

procedure TMainFormCloseActions.ActivateDataPage;
begin
  FForm.PageControl1.ActivePage := FForm.TabSheet2;
end;

procedure TMainFormCloseActions.SaveCurrentPerson;
begin
  FForm.speich1(FForm);
end;

procedure TMainFormCloseActions.DeleteGeneratedReportFiles;
var
  Index: Integer;
  FileName: string;
begin
  FForm.FileListBox2.Directory := GetCurrentDir;
  FForm.FileListBox2.Mask := rsQ_SpS;
  for Index := 0 to FForm.FileListBox2.Items.Count - 1 do
  begin
    FileName := IncludeTrailingPathDelimiter(FForm.FileListBox2.Directory) +
      FForm.FileListBox2.Items[Index];
    DeleteFileOrRaise(FileName);
  end;
end;

function TMainFormCloseActions.ConfirmApplicationExit: Boolean;
begin
  Result := MessageDlg(rsExitQuestuion, mtConfirmation, [mbYes, mbNo], 0) =
    mrYes;
end;

procedure TMainFormCloseActions.PostPendingPerson;
var
  CurrentPersonField: TField;
begin
  CurrentPersonField := FForm.DBText1.Field;
  if CurrentPersonField = nil then
    raise EInvalidOperation.Create('DBText1 has no bound field during close.');
  if (CurrentPersonField.AsString <> '') and
    (Ord(DataModule2.Table1.State) < Ord(dsSetKey)) then
    PostDataSetOrReportError(DataModule2.Table1, 'die aktuelle Person');
end;

procedure TMainFormCloseActions.PostPendingMarriage;
begin
  if (Ord(DataModule2.Table5.State) < Ord(dsSetKey)) and
    (DataModule2.Table5Numr.AsInteger <= 0) and
    (DataModule2.Table5Epnum.AsInteger <= 0) then
    PostDataSetOrReportError(DataModule2.Table5, 'die aktuelle Ehe');
end;

procedure TMainFormCloseActions.CreateBackupWhenPersonExists;
begin
  if DataModule2.Table1Nummer.AsInteger > 0 then
    FForm.datsich(FForm);
end;

procedure TMainFormCloseActions.CloseApplicationDataSets;
begin
  DataModule2.Table1.Close;
  DataModule2.Table4.Close;
  DataModule2.Table5.Close;
  DataModule2.Table20.Close;
  DataModule2.Table35.Close;
end;

procedure TMainFormCloseActions.DeleteAuxiliaryTextFiles;
begin
  DeleteFileOrRaise(rsVorfaTxt);
  DeleteFileOrRaise(rsKnTxt);
end;

procedure TMainFormCloseActions.WriteCaptionConfiguration;
var
  FileName: string;
begin
  FileName := IncludeTrailingPathDelimiter(ExtractFilePath(Application.ExeName)) +
    rsParCfg;
  WriteMainFormCaptionConfiguration(FileName, FForm.Caption);
end;

procedure TMainFormCloseActions.ClearCachedPasswords;
begin
  // SQLDB has no BDE TSession password cache to clear.
end;

procedure TMainFormCloseActions.TerminateApplication;
begin
  Application.Terminate;
end;

procedure TMainFormCloseActions.CancelClose;
begin
  FCloseAction^ := Forms.caNone;
end;

