function TForm1.Proc_005D32CC(S: string): string;
var
  I: Integer;
begin
  Result := S;

  // 1. Fall: '..'
  if Trim(S) = '..' then
  begin
    Result := '';
    Exit;
  end;

  // 2. Fall: Startet mit 'HK'
  if Copy(S, 1, 2) = 'HK' then
  begin
    Result := 'HK ' + Copy(S, 4, 7);
    Exit;
  end;

  // 3. Fall: Enthält 'vo.r'
  if Pos('vo.r', S) > 0 then
  begin
    Result := Copy(S, 1, 2) + Copy(S, 4, 1) + ' ' + RightStr(S, 4);
    Exit;
  end;

  // 4. Fall: Enthält 'na.ch'
  if Pos('na.ch', S) > 0 then
  begin
    Result := Copy(S, 1, 2) + Copy(S, 4, 2) + ' ' + RightStr(S, 4);
    Exit;
  end;

  // 5. Fall: Standard-Bereinigung
  if Length(Trim(S)) > 0 then
  begin
    Result := '';
    
    // Führende Punkte und Leerzeichen abschneiden
    while (Length(S) > 0) and (Pos(S[1], '. ') > 0) do
      S := Copy(S, 2, 9);

    Result := S;

    // Wenn das erste Zeichen ein Buchstabe / > '9' ist:
    if (Length(S) > 0) and (S[1] > '9') then
    begin
      Result := '';
      // Alle Punkte '.' entfernen
      for I := 1 to Length(S) do
      begin
        if S[I] <> '.' then
          Result := Result + S[I];
      end;

      // An der ersten Stelle mit Zeichen < ':' (Ziffer o.ä.) ein Leerzeichen einfügen
      for I := 1 to Length(Result) do
      begin
        if Result[I] < ':' then
        begin
          Insert(' ', Result, I);
          Break;
        end;
      end;
    end;
  end;
end;

// Format PadLeftZero
  // Formatiert die Zahl als 6-stelligen String mit führenden Nullen (z. B. 42 -> '000042')
// can be repacedwith:  Result := Format('%.6d', [Value]);
function TForm1.Proc_005D3228(Value: Integer): string;
var
  S: string;
begin
  // Entspricht exakt der Logik im Maschinencode:
  S := '000000' + IntToStr(Value); // bzw. Proc_00409950(Value)
  Result := Copy(S, Length(S) - 5, 6);
end;

// Replace Picture-Ending
function TForm1.Proc_005FBFD8(const FileName: string): string;
var
  S: string;
  I: Integer;
begin
  // 1. Vorverarbeitung des Dateinamens/Strings
  S := ExtractFileName(FileName);

  // 2. Die letzten 3 Zeichen abschneiden (3x Delete am Ende)
  for I := 1 to 3 do
    Delete(S, Length(S), 1);

  // 3. 'jpg' als neue Endung anhängen
  Result := S + 'jpg';
end;

// PadLeft
function TForm1.Proc_005D3AB8(Value: Extended): string;
var
  S: string;
begin
  // 1. Aufruf der Konvertierungs-/Formatierungsfunktion mit den übergebenen Parametern
  // 2. Voranstellen von 25 Leerzeichen
  S := '                         ' + FloatToStr(Value);

  // 3. Weiterverarbeitung (z. B. Einrücken / Zeichnen / Loggen) mit Längenangabe 25 und Form-Referenz
  Result := RightStr(S, 25);
end;

end.
